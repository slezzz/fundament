SAFE_BROWSING_API_KEY=
MOCK_SAFE_BROWSING=0
FUNDAMENT_LISTEN=127.0.0.1
FUNDAMENT_PORT=8787

# Pay + reputation origin the extension calls. Production: https://pay.yourdomain.tld
VITE_REPUTATION_URL=http://127.0.0.1:8787
# HTTPS origin injected into externally_connectable at build time (success page → extension).
VITE_PAY_ORIGIN=
VITE_CHECKOUT_URL=
VITE_PRO_PRICE_LABEL=

# Dev key only — matches src/billing/publicKey.ts. Run npm run license:keygen before any store build.
LICENSE_PRIVATE_KEY_PKCS8_B64=MC4CAQAwBQYDK2VwBCIEIGow2bwmfeQU4rx99iwrF5r+u2wdb+JmyC84+3n0t0l3
LICENSE_DAYS=365

# Never 1 on the public host.
ALLOW_DEMO_CHECKOUT=0
PUBLIC_BASE_URL=http://127.0.0.1:8787

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_MODE=payment
STRIPE_WEBHOOK_SECRET=
