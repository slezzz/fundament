{
  "name": "fundament",
  "version": "1.2.0",
  "private": true,
  "description": "The security layer for your browser.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "node scripts/compile-filters.mjs && tsc --noEmit && vite build",
    "filters": "node scripts/compile-filters.mjs",
    "pack:sign": "node scripts/sign-pack.mjs",
    "preview": "vite build && echo Load dist/ in chrome://extensions",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test && node scripts/e2e-store-zip.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs",
    "server": "node server/index.mjs",
    "license:issue": "node server/issue-license.mjs",
    "license:keygen": "node server/generate-license-keys.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release": "node scripts/release-check.mjs && npm run build",
    "pack": "node scripts/pack-store.mjs",
    "feeds": "node scripts/fetch-threat-feeds.mjs",
    "domain-data": "node scripts/build-domain-data.mjs",
    "measure:pages": "node scripts/measure-page-signals.mjs"
  },
  "dependencies": {
    "punycode": "^2.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.1",
    "@types/punycode": "^2.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
